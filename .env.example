# Copy to .env and adjust for your machine (never commit .env).

# HTTP port
# PORT=3000

# Admin credentials (seeded on first run). No defaults — the app refuses to
# start unless these are set to real values.
# ADMIN_EMAIL=admin@marygoldcollections.com
# ADMIN_PASSWORD=<change-me-to-a-strong-password>

# Signing secret for admin sessions (required):  openssl rand -hex 32
# SESSION_SECRET=<generated-with-openssl-rand-hex-32>

# PostgreSQL connection — either a single DATABASE_URL (preferred)...
# DATABASE_URL=postgresql://novacart:novacart@localhost:5432/novacart
# Add ssl when the provider requires TLS:
# DATABASE_URL=postgresql://user:pass@host:5432/novacart?sslmode=require

# ...or individual variables (these are the defaults)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=novacart
# PGPASSWORD=novacart
# PGDATABASE=novacart
# PGSSL=true   # 1 / true / required / preferred

# Outgoing mail (welcome emails + order notifications).
# With no SMTP host the emails are printed to the server log instead,
# which is handy for local development.
# STORE_EMAIL=admin@marygoldcollections.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=Marygold Collections <no-reply@marygoldcollections.com>

# Public base URL used for links inside emails (order tracking, unsubscribe).
# Point at the deployed host in production, not localhost.
# APP_BASE_URL=https://marygoldcollections.example.com

# WhatsApp support number used on the order-tracking page, in international
# format with country code and no +/spaces, e.g. 2348012345678.
# WHATSAPP_NUMBER=