# Copy to .env and adjust for your machine (never commit .env).

# HTTP port
# PORT=3000

# Admin credentials (seeded on first run). No defaults — the app refuses to
# start unless these are set to real values.
# ADMIN_EMAIL=admin@marygoldcollections.com
# ADMIN_PASSWORD=<change-me-to-a-strong-password>

# Signing secret for admin sessions (required):  openssl rand -hex 32
# SESSION_SECRET=<generated-with-openssl-rand-hex-32>

# PostgreSQL connection — either a single DATABASE_URL (preferred)...
# DATABASE_URL=postgresql://novacart:novacart@localhost:5432/novacart
# Add ssl when the provider requires TLS:
# DATABASE_URL=postgresql://user:pass@host:5432/novacart?sslmode=require

# --- Persistent product media (object storage) ---
# Admin-uploaded product images/videos are stored here so they survive Render
# restarts and redeploys. When these are set, uploads go to S3-compatible
# object storage (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces,
# MinIO ...). When they are NOT set the app falls back to public/uploads,
# which matches localhost development but is ephemeral on Render.
# S3_BUCKET=novacart-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT=s3.amazonaws.com
#   # Other providers (see their docs):
#   # Cloudflare R2:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (+ S3_FORCE_PATH_STYLE=true)
#   # Backblaze B2:   s3.us-west-002.backblazeb2.com                (+ S3_FORCE_PATH_STYLE=true)
#   # DigitalOcean:   s3.<region>.digitaloceanspaces.com
#   # MinIO:          http://localhost:9000                         (+ S3_ENDPOINT_SSL=false, S3_FORCE_PATH_STYLE=true)
# S3_ENDPOINT_SSL=true          # true/false; auto-detected from S3_ENDPOINT scheme
# S3_FORCE_PATH_STYLE=false     # true for R2/B2/MinIO; false for AWS virtual-host style
# # Public URL prefix for stored objects (used as the image/video URL in the
# # database and storefront). Must be publicly readable.
# # AWS S3:    https://<bucket>.s3.<region>.amazonaws.com
# # R2:        https://media.yourstore.com   (a public bucket + custom domain / R2.dev)
# # Spaces:    https://<bucket>.<region>.digitaloceanspaces.com
# # MinIO:     http://localhost:9000/<bucket>
# S3_PUBLIC_URL=https://yourstore.example.com/media
# S3_UPLOAD_PREFIX=             # optional key prefix, e.g. "products"

# ...or individual variables (these are the defaults)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=novacart
# PGPASSWORD=novacart
# PGDATABASE=novacart
# PGSSL=true   # 1 / true / required / preferred

# Outgoing mail (welcome emails + order notifications).
# With no SMTP host the emails are printed to the server log instead,
# which is handy for local development.
# STORE_EMAIL=admin@marygoldcollections.com
#
# EMAIL_* variables are the production-preferred names (the app reads them
# first) and are also what the app logs as missing in production. The SMTP_*
# names below are accepted as a legacy alias — both map to the same settings.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=you@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password
# EMAIL_FROM=NovaCart <onweebi12@gmail.com>
# EMAIL_FROM_NAME=NovaCart
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false; the
# password must be a Gmail App Password (22 chars, no spaces), not your login
# password — enable 2-step verification in Google then create one under
# https://myaccount.google.com/apppasswords.
#
# Legacy alias, ignored when EMAIL_* is present:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=Marygold Collections <no-reply@marygoldcollections.com>

# Public base URL used for links inside emails (order tracking, unsubscribe).
# Point at the deployed host in production, not localhost. Without it,
# emails build links against the local server and the app logs a warning.
# APP_BASE_URL=https://novacart-ecommerce-1-9drb.onrender.com

# WhatsApp support number used on the order-tracking page, in international
# format with country code and no +/spaces, e.g. 2348012345678.
# WHATSAPP_NUMBER=