# Copy to .env and adjust for your machine (never commit .env).

# HTTP port
# PORT=3000

# Admin credentials (seeded on first run)
# ADMIN_EMAIL=admin@novacart.com
# ADMIN_PASSWORD=admin123

# Signing secret for admin sessions:  openssl rand -hex 32
# SESSION_SECRET=change-me

# MySQL connection — either a single DATABASE_URL...
# DATABASE_URL=mysql://novacart:novacart@localhost:3306/novacart

# ...or individual variables (these are the defaults)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=novacart
# MYSQL_PASSWORD=novacart
# MYSQL_DATABASE=novacart